<div>

	<div class="ap-resource party">
		<div class="flexcol">
			<h4>
				{{localize "AC2D20.TEMPLATES.PARTY_MOMENTUM"}}
			</h4>
		</div>

		<div class="flexrow align-mid">
			<a class="ap-btn ap-sub" data-action="decrementPool" data-type="partyMomentum">
				<i class="fa-solid fa-minus"></i>
			</a>

			<input
				class="ap-input num-short-3"
				data-dtype="Number"
				type="number"
				name="partyMomentum"
				value="{{partyMomentum}}"
			>

			<a class="ap-btn ap-add" data-action="incrementPool" data-type="partyMomentum">
				<i class="fa-solid fa-plus"></i>
			</a>
		</div>
	</div>

	{{#if showGMMomentum}}
		<div class="ap-resource gm">
			<div class="flexcol">
				<h4>
					{{localize "AC2D20.TEMPLATES.GM_MOMENTUM"}}
				</h4>
			</div>
			<div class="flexrow align-mid">
				{{#if isGM}}
					<a class="ap-btn ap-sub" data-action="decrementPool" data-type="gmMomentum">
						<i class="fa-solid fa-minus"></i>
					</a>
				{{else}}
					<div class="ap-btn">
						<i class="fa-solid fa-minus"></i>
					</div>
				{{/if}}

				<input
					class="ap-input num-short-3"
					type="number"
					data-dtype="Number"
					value={{gmMomentum}}
					name=gmMomentum
					{{#unless isGM}}
						disabled
					{{/unless}}
				>

				{{#if isGM}}
					<a class="ap-btn ap-add" data-action="incrementPool" data-type="gmMomentum">
						<i class="fa-solid fa-plus"></i>
					</a>
				{{else}}
					<div class="ap-btn">
						<i class="fa-solid fa-plus"></i>
					</div>
				{{/if}}
			</div>
		</div>
	{{/if}}

</div>
